# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local a git (ya está en .gitignore). Ejecuta `npm run secrets:scan` antes de commitear.

# ------------------------------------------------------------------
# CLAVE PÚBLICA (única permitida en el navegador)
# La anon key es pública por diseño: su seguridad vive en el RLS.
# El código del cliente rechaza cualquier clave que no sea anon/publishable.
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# SECRETOS DE SERVIDOR (sin prefijo NEXT_PUBLIC => nunca llegan al navegador)
# Nunca los exportes con prefijo NEXT_PUBLIC_ ni los copies en componentes 'use client'.
# ------------------------------------------------------------------
# Clave de cifrado AES-256-GCM para campos sensibles (notas del DM, secretos de NPC).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FIELD_ENCRYPTION_KEY=

# Semilla para derivar claves de rate limiting / firmas internas del servidor.
SESSION_SIGNING_SECRET=

# ------------------------------------------------------------------
# OPCIONALES
# ------------------------------------------------------------------
# Intentos de login permitidos por IP+email antes del bloqueo (por defecto 5)
LOGIN_RATE_LIMIT_MAX=5
# Ventana del bloqueo en segundos (por defecto 900 = 15 min)
LOGIN_RATE_LIMIT_WINDOW=900

# --- OpenRouter (API de LLM) ---
# Clave de API: https://openrouter.ai/settings/keys
# NUNCA uses el prefijo NEXT_PUBLIC_ ni la pegues en next.config.js / settings.json.
OPENROUTER_API_KEY=sk-or-v1-reemplaza-esta-clave
# URL base del endpoint (OpenAI-compatible)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Modelo por defecto (opcional)
OPENROUTER_MODEL=
